# ── Core ──────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import_secrets;print(secrets.token_urlsafe(64))"
DEBUG=False
ALLOWED_HOSTS=projetoraven.com,api.projetoraven.com,ws.projetoraven.com
SITE_URL=https://projetoraven.com

# ── Database ───────────────────────────────────────────────────────────────────
USE_SQLITE=False
POSTGRES_DB=projeto_raven
POSTGRES_USER=raven
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis fica isolado na rede interna Docker (não expõe porta no host).
# O nome do serviço "redis" é resolvido internamente pelo Docker Compose.
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/1
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/2
CHANNEL_LAYER_URL=redis://:CHANGE_ME_redis_password@redis:6379/3

# ── Portas expostas no host (para o Cloudflare Tunnel rotear) ────────────────
# Cloudflare Tunnel:
#   projetoraven.com         → http://localhost:3100  (Next.js)
#   api.projetoraven.com     → http://localhost:8100  (Django)
#   ws.projetoraven.com      → http://localhost:8100  (Django WebSocket)
FRONTEND_PORT=3100
DJANGO_PORT=8100

# ── CORS / CSRF ────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://projetoraven.com
CSRF_TRUSTED_ORIGINS=https://projetoraven.com,https://api.projetoraven.com

# ── Email ──────────────────────────────────────────────────────────────────────
# Configure via painel admin (SMTP Settings) ou preencha aqui:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=projetoraveen@gmail.com
# EMAIL_HOST_PASSWORD=CHANGE_ME
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Projeto Raven <projetoraveen@gmail.com>
EMAIL_SETTINGS_ENCRYPTION_SALT=CHANGE_ME_random_salt_32_chars

# ── JWT RSA Keys ──────────────────────────────────────────────────────────────
# As chaves ficam em Backend/keys/ (montadas como volume read-only no container).
# Geradas automaticamente pelo setup.sh — só altere os paths se mudar o local.
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# ── Admin padrão (criado automaticamente pelo seed_prod) ─────────────────────
# Se preenchido, o seed_prod cria/atualiza este usuário como superadmin no boot.
DJANGO_ADMIN_EMAIL=CHANGE_ME_admin@projetoraven.com
DJANGO_ADMIN_USERNAME=CHANGE_ME_admin
DJANGO_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── Acesso restrito por IP ────────────────────────────────────────────────────
# IPs com acesso ao /admin/ e /api/schema/. Vazio = sem restrição por IP.
# Ex: ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
ADMIN_ALLOWED_IPS=

# ── API Schema / Swagger ──────────────────────────────────────────────────────
# False em produção por padrão. Defina True para re-habilitar /api/schema/swagger-ui/
SCHEMA_ENABLED=False

# ── OAuth Google ──────────────────────────────────────────────────────────────
# Crie as credenciais em: https://console.cloud.google.com/apis/credentials
#   1. Crie um projeto → Credenciais → Criar credencial → ID do cliente OAuth 2.0
#   2. Tipo: Aplicativo da Web
#   3. Origens JavaScript autorizadas: https://projetoraven.com
#   4. URIs de redirecionamento autorizados: https://api.projetoraven.com/api/v1/accounts/oauth/google/callback/
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
METRICS_ENABLED=False

# ── Rate limiting ─────────────────────────────────────────────────────────────
REST_THROTTLING_ENABLED=True
REST_THROTTLE_ANON=100/min
REST_THROTTLE_USER=300/min
REST_THROTTLE_LOGIN=10/min
REST_THROTTLE_REGISTER=3/hour
REST_THROTTLE_PASSWORD_RESET=3/hour
REST_THROTTLE_OTP=5/minute
REST_THROTTLE_FORUM_POST=20/minute
REST_THROTTLE_BLOG_POST=10/minute
REST_THROTTLE_COMMENT=10/minute

# ── App versioning (injected by CI/CD) ────────────────────────────────────────
APP_VERSION=
APP_BUILD_SHA=
APP_BUILD_TIME=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Gerado automaticamente pelo setup.sh
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
VAPID_ADMIN_EMAIL=projetoraveen@gmail.com

# ── TOTP Encryption Key ───────────────────────────────────────────────────────
# Chave Fernet usada para criptografar segredos TOTP no banco.
# Se vazia, deriva do DJANGO_SECRET_KEY (funciona, mas perde os TOTP se a SECRET_KEY mudar).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# ── SSL / Proxy ───────────────────────────────────────────────────────────────
# False porque o Cloudflare Tunnel já termina TLS externamente.
# Django recebe HTTP puro de localhost — não deve forçar redirect para HTTPS.
SECURE_SSL_REDIRECT=False

# ── Misc ──────────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING
LOG_FORMAT=json

# ── Seed na inicialização ─────────────────────────────────────────────────────
# Por padrão o container Django roda migrate + seed_prod + collectstatic no boot.
# Se quiser desativar o seed em reinícios (ex.: já populou as categorias/tags),
# defina RUN_SEED_PROD=false.
RUN_SEED_PROD=true
RUN_MIGRATE=true
RUN_COLLECTSTATIC=true
BOOTSTRAP_USE_DB_LOCK=true
BOOTSTRAP_LOCK_ID=9034212341234

ADMIN_BACKUP_ALLOW_RESTORE=false

# ── Usuário de suporte (opcional) ─────────────────────────────────────────────
# Desativado por padrão. Se ativar, defina credenciais fortes.
CREATE_SUPPORT_USER=false
SUPPORT_USER_USERNAME=suporte
SUPPORT_USER_EMAIL=projetoraveen@gmail.com
SUPPORT_USER_PASSWORD=CHANGE_ME_strong_support_password
